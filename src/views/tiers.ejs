<%- include('layout', { title: 'Tiers & entitlements', showLogout: true }) %>
  <nav class="subnav">
    <a href="/admin">Dashboard</a>
    <a href="/admin/tenants">Tenants</a>
    <a href="/admin/tiers" class="active">Tiers &amp; entitlements</a>
    <a href="/admin/events">Events log</a>
  </nav>

  <h1>Tiers &amp; entitlements</h1>
  <p class="muted">
    Each tier maps to a set of unlocked features (booleans) and quantitative limits (integers; <code>-1</code> = unlimited).
    Feature code in Dojo Master should call <code>Licensing::can('feature.x')</code> or <code>Licensing::limit('limit.x')</code> — never
    hardcode tier names.
  </p>

  <% tiers.forEach(function (tier) { %>
    <div class="card">
      <h2><%= tier.display_name %> <span class="muted"><code><%= tier.code %></code></span></h2>

      <form method="post" action="/admin/tiers/<%= tier.id %>" class="inline-form">
        <label>
          Display name
          <input type="text" name="display_name" value="<%= tier.display_name %>" required />
        </label>
        <label>
          Billing interval
          <select name="billing_interval">
            <% billingIntervals.forEach(function (iv) { %>
              <option value="<%= iv %>" <%= (tier.billing_interval || 'monthly') === iv ? 'selected' : '' %>><%= iv %></option>
            <% }); %>
          </select>
        </label>
        <label>
          Flat amount ($)
          <input type="number" step="0.01" min="0" name="flat_amount_dollars"
                 value="<%= centsToDollarsString(tier.flat_amount_cents) %>"
                 placeholder="e.g. 29.00" />
        </label>
        <label>
          Stripe price ID (flat)
          <input type="text" name="stripe_price_id" value="<%= tier.stripe_price_id || '' %>" placeholder="price_…" />
        </label>

        <label>
          Metered unit
          <select name="metered_unit">
            <option value="" <%= !tier.metered_unit ? 'selected' : '' %>>— none —</option>
            <% meteredUnits.forEach(function (u) { %>
              <option value="<%= u %>" <%= tier.metered_unit === u ? 'selected' : '' %>><%= u %></option>
            <% }); %>
          </select>
        </label>
        <label>
          Included units
          <input type="number" min="0" step="1" name="included_units"
                 value="<%= tier.included_units != null ? tier.included_units : 0 %>"
                 placeholder="0" />
        </label>
        <label>
          Per-unit amount ($)
          <input type="number" step="0.01" min="0" name="unit_amount_dollars"
                 value="<%= centsToDollarsString(tier.unit_amount_cents) %>"
                 placeholder="e.g. 1.00" />
        </label>
        <label>
          Stripe price ID (metered)
          <input type="text" name="stripe_metered_price_id"
                 value="<%= tier.stripe_metered_price_id || '' %>" placeholder="price_…" />
        </label>

        <button type="submit">Save tier</button>
      </form>

      <p class="muted small">
        <% if (!tier.metered_unit && !tier.flat_amount_cents) { %>
          No billing configured yet.
        <% } else if (!tier.metered_unit) { %>
          Flat: $<%= centsToDollarsString(tier.flat_amount_cents) %> / <%= tier.billing_interval || 'monthly' %>.
        <% } else if (!tier.flat_amount_cents) { %>
          Metered: $<%= centsToDollarsString(tier.unit_amount_cents) %> per <%= tier.metered_unit %> / <%= tier.billing_interval || 'monthly' %>
          <% if (tier.included_units) { %>(first <%= tier.included_units %> included)<% } %>.
        <% } else { %>
          Mixed: $<%= centsToDollarsString(tier.flat_amount_cents) %> base + $<%= centsToDollarsString(tier.unit_amount_cents) %> per <%= tier.metered_unit %> over <%= tier.included_units || 0 %> / <%= tier.billing_interval || 'monthly' %>.
        <% } %>
      </p>

      <form method="post" action="/admin/tiers/<%= tier.id %>/entitlements">
        <table>
          <thead>
            <tr><th>Entitlement</th><th>Kind</th><th style="width:14rem">Value</th></tr>
          </thead>
          <tbody>
            <% entitlements.forEach(function (e) { %>
              <% var value = lookup[tier.id][e.id]; %>
              <% var present = lookup[tier.id].hasOwnProperty(e.id); %>
              <tr>
                <td>
                  <strong><%= e.display_name %></strong>
                  <br /><code><%= e.code %></code>
                  <% if (e.description) { %>
                    <br /><span class="muted"><%= e.description %></span>
                  <% } %>
                </td>
                <td class="muted"><%= e.kind %></td>
                <td>
                  <% if (e.kind === 'boolean') { %>
                    <label class="inline">
                      <input type="checkbox" name="feature_<%= e.id %>" value="1" <%= present ? 'checked' : '' %> />
                      enabled
                    </label>
                  <% } else { %>
                    <input type="number" name="limit_<%= e.id %>"
                           value="<%= present ? value : '' %>"
                           placeholder="leave blank to disable"
                           step="1" />
                    <span class="muted small"> -1 = unlimited</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <button type="submit">Save entitlements</button>
      </form>
    </div>
  <% }); %>
<%- include('footer') %>
